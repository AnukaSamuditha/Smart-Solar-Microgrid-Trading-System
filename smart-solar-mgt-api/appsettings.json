{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "smart-solar-mgt-api",
    "Audience": "smart-solar-mgt-clients",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Mongo": {
    "DatabaseName": "smart_solar_mgt"
  },
  "Smtp": {
    "Port": 1025,
    "From": "no-reply@smart-solar-mgt.local",
    "UseSsl": false
  },
  "Invitation": {
    "TokenLifetimeHours": 48,
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}
