# .env.example
#
# Variables for the LOCAL DEV Docker Compose stack only (docker-compose.local.yml — MongoDB
# and MailHog). Copy to .env and adjust ports if they conflict with something else on your
# machine; neither service needs credentials for local development.
#
# The application's OWN secrets (Jwt__SigningKey, Mongo__ConnectionString, Smtp__User,
# Smtp__Password, Seed__SuperAdminEmail, Seed__SuperAdminUsername, Seed__SuperAdminPassword)
# are NOT set here — use `dotnet user-secrets` locally, or environment variables on the IIS
# app pool in production. See docs/authentication-implementation-approach.md, section 9.

MONGO_PORT=27017
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
