<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>smart_solar_mgt_api</RootNamespace>
    <UserSecretsId>6679b231-cb43-436a-81bd-0361bf051905</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.2" />
  </ItemGroup>

  <!-- The test project lives in a nested folder (smart-solar-mgt-api.Tests/); exclude it from
       this project's default globs so its own build output isn't picked up as part of this
       project's compilation. -->
  <ItemGroup>
    <Compile Remove="smart-solar-mgt-api.Tests/**/*.cs" />
    <Content Remove="smart-solar-mgt-api.Tests/**/*" />
    <None Remove="smart-solar-mgt-api.Tests/**/*" />
  </ItemGroup>

</Project>
