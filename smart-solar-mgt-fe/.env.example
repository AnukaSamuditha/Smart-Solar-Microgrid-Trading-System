# .env.example
#
# API_URL — base URL of the smart-solar-mgt-api backend. The browser never calls it directly:
# next.config.ts proxies /api/v1/* on this app's own origin to it, so the API's auth cookies are
# first-party here. Read at build/dev-server start time. Defaults to the API's local http profile.
API_URL=http://localhost:5011
