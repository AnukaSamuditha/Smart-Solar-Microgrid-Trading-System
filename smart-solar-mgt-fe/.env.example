# .env.example
#
# NEXT_PUBLIC_API_URL — base URL of the smart-solar-mgt-api backend. Must be included in that
# API's Cors:AllowedOrigins (see smart-solar-mgt-api/appsettings.json) for the browser to be
# allowed to send/receive the HttpOnly auth cookies. Defaults to the API's local http profile.
NEXT_PUBLIC_API_URL=http://localhost:5011
