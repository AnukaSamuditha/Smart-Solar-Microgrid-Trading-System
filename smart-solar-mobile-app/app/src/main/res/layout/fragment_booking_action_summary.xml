<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/solar_background">

    <ImageButton
        android:id="@+id/btnBack"
        style="@style/Widget.App.Button.Back"
        android:layout_marginStart="@dimen/spacing_small_gap"
        android:layout_marginTop="@dimen/spacing_small_gap" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_screen_horizontal">

        <ProgressBar
            android:id="@+id/progressActionSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/solar_primary" />

        <TextView
            android:id="@+id/tvActionSummaryError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/status_cancelled"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/groupActionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/actionIconContainer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:id="@+id/ivActionIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_approved"
                    app:tint="@color/solar_on_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvActionHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.App.ScreenTitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_section_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSummaryStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/solar_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSummaryDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/solar_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSummaryEnergy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/solar_text_secondary"
                        android:textSize="14sp" />

                    <View style="@style/App.Divider" android:layout_marginVertical="14dp" />

                    <TextView
                        android:id="@+id/tvSummaryBookingId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/solar_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSummaryStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.App.StatusText" />

                    <TextView
                        android:id="@+id/tvSummarySyncStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/solar_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Always available once loading finishes, whether the summary loaded or errored -
             this screen is never a dead end. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_section_gap"
            android:text="Back to Bookings"
            android:visibility="gone" />

    </LinearLayout>
    </ScrollView>
</LinearLayout>
