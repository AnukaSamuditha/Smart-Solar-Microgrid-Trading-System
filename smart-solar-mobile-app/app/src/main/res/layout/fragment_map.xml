<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_background">

    <FrameLayout
        android:id="@+id/mapPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/mapContainer"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMapBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/solar_surface_elevated"
        android:textColor="@color/solar_text_primary"
        android:padding="10dp"
        android:gravity="center"
        android:textSize="13sp"
        android:text="You're offline - map tiles may not load"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomSheetStations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:behavior_peekHeight="@dimen/bottom_sheet_peek_height"
        app:behavior_hideable="false"
        app:behavior_fitToContents="false"
        app:behavior_skipCollapsed="false">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_screen_horizontal"
            android:paddingEnd="@dimen/spacing_screen_horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:text="Charging Stations"
            android:textAppearance="@style/TextAppearance.App.SectionTitle" />

        <!-- Height is set explicitly in code (MapFragment), not via layout_weight:
             BottomSheetBehavior's measurement of this LinearLayout does not distribute weight
             to fixed-size siblings the normal way, so a weighted height here would let station
             rows render behind the floating nav pill regardless of any sibling spacer/margin. -->
        <FrameLayout
            android:id="@+id/stationListArea"
            android:layout_width="match_parent"
            android:layout_height="0dp">

            <com.example.smart_solar_mgt_app.core.common.NestedScrollAwareSwipeRefreshLayout
                android:id="@+id/swipeRefreshMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false" />
            </com.example.smart_solar_mgt_app.core.common.NestedScrollAwareSwipeRefreshLayout>

            <ProgressBar
                android:id="@+id/progressMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/solar_primary" />

            <TextView
                android:id="@+id/tvEmptyMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No stations available"
                android:textColor="@color/solar_text_secondary"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
