<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshOpHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/spacing_screen_horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRID OPERATOR"
                    android:textColor="@color/solar_text_muted"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Operational Console"
                    android:textAppearance="@style/TextAppearance.App.ScreenTitle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpLogout"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressOpHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/solar_primary" />

        <TextView
            android:id="@+id/tvOpHomeEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/spacing_screen_horizontal"
            android:gravity="center"
            android:text="No pending approvals"
            android:textColor="@color/solar_text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOpPending"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
