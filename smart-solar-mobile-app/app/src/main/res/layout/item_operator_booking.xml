<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.CardView.Small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvObStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/solar_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvObNic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/solar_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvObDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/solar_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvObEnergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/solar_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvObStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.App.StatusText" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
